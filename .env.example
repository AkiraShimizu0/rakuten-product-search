# Copy to .env locally. Never commit credentials.
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# Optional registered application origin (only if required by your Rakuten app)
RAKUTEN_ORIGIN=

# Day 2: official TypeSafe key (never commit a real value)
JEV_API_KEY=
# Optional: pin model for reproducibility and use the API origin plus /v1
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0

# Day 3: Anthropic Claude Messages API. Empty means dry-run only.
ANTHROPIC_API_KEY=
